# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/claim_integrity
# Used by pytest. The database is dropped and recreated on every test run,
# so its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/claim_integrity_test

# --- AI answer engine (all optional) ------------------------------------------
# Each key switches that engine from demo answers to live answers. Leave empty to skip it.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Override API endpoints only if a provider moves them.
# OPENAI_API_URL=https://api.openai.com/v1/responses
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# PERPLEXITY_API_URL=https://api.perplexity.ai/v1/sonar

# Answer analysis uses Claude if ANTHROPIC_API_KEY is set, else a local Ollama model if it is
# running, else built-in rules.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# AI referral traffic: import a CSV export from GA4 (or any analytics tool) under
# AEO / GEO > Crawlers & traffic. A direct GA4 connection is not built yet; setting the
# property ID only marks it as planned.
# GA4_PROPERTY_ID=
